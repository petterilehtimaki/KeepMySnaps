# ─── Supabase ────────────────────────────────────────────────────────────────
# Both of these are sent to the browser — that's what NEXT_PUBLIC_ means — so
# only ever the *publishable* key here (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. This one bypasses RLS, so it must never gain a NEXT_PUBLIC_
# prefix and must never be imported into a client component. It's what
# src/app/api/unlock/route.ts uses to write the `unlocks` table, which denies
# anon and authenticated outright.
SUPABASE_SECRET_KEY=

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Server-only secret key (sk_test_... while you're testing, sk_live_... when
# you're not). Creates Checkout sessions and verifies them afterwards. Without
# it the paywall button answers with a plain "payments aren't configured"
# rather than crashing.
STRIPE_SECRET_KEY=

# ─── Site ────────────────────────────────────────────────────────────────────
# Optional. Sets where Stripe sends people after paying. Leave blank and the
# API route uses the origin of the incoming request, which is right in
# development and on Vercel. Set it explicitly if you sit behind a proxy that
# rewrites Host.
NEXT_PUBLIC_SITE_URL=
