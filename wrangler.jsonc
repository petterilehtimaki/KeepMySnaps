{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "keepmysnaps",
  "compatibility_date": "2026-09-18",
  // nodejs_compat is what lets the Stripe and Supabase SDKs run unchanged.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Both hostnames point at this worker. The bare domain only ever gets a 301
  // to www from the middleware; it is attached here so that redirect happens
  // at all, rather than the domain answering nothing.
  "routes": [
    { "pattern": "www.keepmysnaps.com", "custom_domain": true },
    { "pattern": "keepmysnaps.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
